# Server Configuration
PORT=3003
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/teammanagement

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Upload Configuration
UPLOAD_DIR=./uploads

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Seed Configuration
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=changeme123
SEED_SUPERADMIN_NAME=Super Admin

# Encryption Configuration
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this

# Finance Configuration
OUTCOME_APPROVAL_THRESHOLD=1000
FINANCE_BLOCK_OVER_BUDGET=false

# Project Configuration
BOSS_CAN_EDIT_PROJECTS=false

# Hub sync API (used by workflow final update)
HUB_SYNC_API_URL=http://127.0.0.1:5000/sync-date
HUB_SYNC_TIMEOUT_MS=120000
